{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@core/*": ["assets/core/*"],
      "@core": ["assets/core/index.ts"]
    }
  },
  "include": [
    "assets/core/**/*.ts",
    "assets/remake/shared/SaveProbe.ts",
    "assets/remake/shared/RemakeLayout.ts",
    "assets/remake/version.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts"
  ]
}
